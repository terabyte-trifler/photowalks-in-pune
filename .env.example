# ---------------------------------------------------------------------------
# Copy to .env.local. Nothing here is required to browse the site: the
# homepage, the walks, the archive and the community are public and work with
# an empty file. Accounts need the two Supabase values; without them the
# login and join screens say so plainly instead of failing.
#
# Never commit .env.local, and never put a service-role key in any variable
# beginning with NEXT_PUBLIC_ — those are compiled into the browser bundle.
# ---------------------------------------------------------------------------

# --- Supabase (authentication + profiles) ----------------------------------
# Dashboard → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL       Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  the anon / publishable key — safe in the
#                                  browser, because Row Level Security is what
#                                  actually guards the data (see
#                                  supabase/migrations/).
# The service_role key is NOT used by this project. Do not add it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Canonical origin ------------------------------------------------------
# Used for metadataBase, Open Graph URLs, and the redirect URLs sent to
# Supabase for Google sign-in and email links. On Vercel, previews fall back to
# VERCEL_URL automatically, so this only needs the production domain.
NEXT_PUBLIC_SITE_URL=https://photowalksinpune.com

# --- Newsletter ------------------------------------------------------------
# Anything accepting POST { email } (see lib/newsletter.ts). Without it,
# signups stay in the visitor's browser and the success state says so.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# --- Instagram -------------------------------------------------------------
# A long-lived Instagram Graph API token, which turns the Instagram section
# into the account's six most recent posts. Without it the section shows the
# local placeholders and says so.
#
# The account must be a Business or Creator account. Full steps are at the top
# of lib/instagram.ts.
#
# LEAVE THIS EMPTY IN PRODUCTION. A token set here expires after 60 days and
# nothing can write the replacement back, so the grid goes stale until somebody
# notices. With it empty and Supabase configured, the token instead lives in
# the vault and the instagram-posts Edge Function rotates it automatically —
# see migration 0013 and supabase/README.md. It is useful locally, for trying a
# token out without touching the project.
#
# Server-side only: note the deliberate absence of NEXT_PUBLIC_. This one is a
# real secret, unlike the Supabase anon key above.
INSTAGRAM_ACCESS_TOKEN=
