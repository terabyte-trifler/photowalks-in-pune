# ---------------------------------------------------------------------------
# Nothing here is required to run the MVP. Each integration has a working local
# fallback, and the UI says plainly when a submission has not reached a server.
# ---------------------------------------------------------------------------

# Supabase — RSVP storage (see lib/rsvp.ts for the table DDL and RLS policy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Newsletter provider accepting POST { email } (see lib/newsletter.ts)
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Instagram Graph API long-lived token (see lib/instagram.ts)
INSTAGRAM_ACCESS_TOKEN=

# Canonical origin, used for metadataBase and Open Graph URLs
NEXT_PUBLIC_SITE_URL=https://photowalksinpune.com
